# Copy this file to .env and fill in real values. .env is gitignored - never commit it.

# Required. Your OpenAI API key - translate.py and the overflow-handling
# retranslate-for-brevity step make real, billed calls with this.
OPENAI_API_KEY=sk-...

# Optional. Which OpenAI model to use for translation and overflow fixes.
# Defaults to gpt-4o in code if unset. The deployed Render instance overrides
# this to gpt-5-mini via render.yaml.
ROSETTA_OPENAI_MODEL=gpt-4o

# Optional. If set, the web app requires HTTP Basic Auth (any username, this
# password) on every request. Leave unset for local-only use - but set this
# before deploying publicly, since every upload triggers real, billed OpenAI
# calls.
SITE_PASSWORD=
